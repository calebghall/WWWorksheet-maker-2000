+{const s=SP.defaults();SP.applyStandard(s,'4.NBT.B.5');const M=s.md;
+  if(!(M.mode==='digits'&&M.da===4&&M.db===1&&M.alt&&M.da2===2&&M.db2===2&&!M.div))issues.push('preset settings '+JSON.stringify(M));
