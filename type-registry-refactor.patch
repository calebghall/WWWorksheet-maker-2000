+const G3_AUNIT = [['unit squares', 'square units', ''], ['squares, each 1 cm by 1 cm,', 'square centimeters', ''], ['squares, each 1 inch by 1 inch,', 'square inches', ''], ['squares, each 1 foot by 1 foot,', 'square feet', '']];
