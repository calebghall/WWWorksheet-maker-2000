+
+const V_DRAWQ = [['circle', 'Draw a circle.'], ['square', 'Draw a square.'], ['triangle', 'Draw a triangle.'], ['rectangle', 'Draw a rectangle.'], ['hexagon', 'Draw a hexagon.']];
+
