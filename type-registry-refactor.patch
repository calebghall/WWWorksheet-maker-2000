+
+/* Flat shapes. s = size in units. Polygons name their side counts in V_SIDES. */
+const V_SIDES = { triangle: 3, square: 4, rectangle: 4, rhombus: 4, trapezoid: 4, pentagon: 5, hexagon: 6 };
